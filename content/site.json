  "about": {
    "kicker": "About the school",
    "title": "History, staff and results",
    "timeline": [
      {
        "year": "1970s",
        "text": "Opened as a Zilla Parishad high school for Arutla and nearby villages."
      },
      { "year": "2023", "text": "Selected as a PM SHRI school." },
      {
        "year": "2024",
        "text": "In November, the Arutla campus became Telangana's first Telangana Public School demonstration campus."
      },
      {
        "year": "2025–26",
        "text": "Campus enrolment more than doubles to 1,585 students after a ₹10.91 crore upgrade."
      }
    ],
    "vision": {
      "title": "Vision",
      "text": "Every child in Arutla completes Class X — confident, curious and ready for what comes next."
    },
    "mission": {
      "title": "Mission",
      "text": "Zero drop-outs between Class VI and X, every classroom digital by 2027, and a green, safe campus the village is proud of."
    },
    "campus": {
      "title": "Telangana Public School campus",
      "paragraphs": [
        "Telangana Public Schools were conceived to give every child a seamless public education from Pre-Primary to Class 12. Existing government schools that share a campus are upgraded into well-resourced schools that parents actively choose over low-performing and high-cost alternatives.",
        "The 5.5-acre Arutla campus once housed four schools, two Anganwadi centres and two hostels that ran separately. They now work as one integrated school with a single Head of School, grade-wise academic leaders and an Estate Manager for non-academic work, so teachers can focus on teaching.",
        "The transformation was led by a 30-member Arutla School Development and Management Committee of parents and community members, who procured materials for all civil works directly under a community contracting model."
      ],
