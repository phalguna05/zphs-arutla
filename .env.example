# PostgreSQL connection string (Vercel: Storage → Postgres/Neon → copy DATABASE_URL).
# Leave empty to run on the mock data in content/mock-data.json (in memory, resets on restart).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin sign-in for /admin (in `npm run dev` these default to admin / arutla@2026)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Random string, at least 32 characters (e.g. `openssl rand -base64 32`)
AUTH_SECRET=""

# Optional: enables photo and PDF uploads from the admin dashboard (Vercel: Storage → Blob)
BLOB_READ_WRITE_TOKEN=""

# Force mock data even when DATABASE_URL is set
# USE_MOCK_DATA="true"
